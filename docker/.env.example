# Werewolves game settings (all prefixed WW_)
# Copy to docker/.env and edit as needed.

# Game composition (6 seats: 1 wolf + 1 witch + 4 town)
WW_MAX_WOLVES=1
WW_MAX_WITCH=1
WW_MAX_TOWN=4

# Join code shared by all players
WW_JOIN_CODE=ruffruff982

# Phase durations (seconds)
WW_WOLF_CHAT_SECONDS=60
WW_WOLF_VOTE_SECONDS=60
WW_WITCH_VOTE_SECONDS=30
WW_DAY_CHAT_SECONDS=60
WW_DAY_VOTE_SECONDS=60
WW_DAWN_SECONDS=20
WW_DUSK_SECONDS=20

# Delay before the next game starts
WW_RESET_DELAY_SECONDS=15

# Max concurrent SSE streams per player
WW_MAX_STREAMS_PER_PLAYER=2

# Presence and liveness
WW_HEARTBEAT_SECONDS=10
WW_PRESENCE_GRACE_SECONDS=60
WW_MAX_DAYS=10

# Client settings (used by player and bot containers)
WW_SERVER_URL=http://server:8000
