# Werewolves Democracy Configuration
# Copy to .env and customize

# Game composition
WW_MAX_WOLVES=2
WW_MAX_WITCH=1
WW_MAX_TOWN=2

# Authentication
WW_JOIN_CODE=ruffruff982

# Phase durations (seconds)
WW_WOLF_CHAT_SECONDS=30
WW_WOLF_VOTE_SECONDS=30
WW_WITCH_VOTE_SECONDS=30
WW_DAY_CHAT_SECONDS=30
WW_DAY_VOTE_SECONDS=30
WW_DAWN_SECONDS=5
WW_DUSK_SECONDS=5

# Seconds to wait after game over before resetting for a new game
WW_RESET_DELAY_SECONDS=10